  "info": {
    "title": "Task Manager API",
    "description": "Users, projects and tasks API. Authenticate with `POST /users/login`, then send the returned token as `Authorization: Bearer <token>`. Every error uses the documented standard error envelope.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "TaskResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Complete NestJS assignment"
          },
          "description": {
            "type": "string",
            "example": "Implement authentication and Swagger documentation"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "completed"
            ],
            "example": "todo"
          },
          "created_at": {
            "format": "date-time",
            "type": "string",
            "example": "2026-11-04T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "email",
            "description": "Field that failed validation, when the error is field-level"
          },
          "message": {
            "type": "string",
            "example": "email must be an email"
          }
        },
        "required": [
          "message"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "error": {
            "type": "string",
            "example": "Not Found"
          },
          "code": {
            "type": "string",
            "example": "NOT_FOUND",
            "description": "Stable machine-readable error code"
          },
          "message": {
            "type": "string",
            "example": "Task with id \"99\" not found"
          },
          "details": {
            "description": "Field-level errors, present only for validation failures",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetailDto"
            }
          },
          "path": {
            "type": "string",
            "example": "/tasks/99"
          },
          "method": {
            "type": "string",
            "example": "GET"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-11-04T10:00:00.000Z"
          }
        },
        "required": [
          "success",
          "statusCode",
          "error",
          "code",
          "message",
          "path",
          "method",
          "timestamp"
        ]
      },
      "CreateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Complete NestJS assignment",
            "description": "Title of the task"
          },
          "description": {
            "type": "string",
            "example": "Implement JWT authentication and Swagger documentation",
            "description": "Description of the task"
          },
          "projectId": {
            "type": "number",
            "example": 1,
            "description": "ID of the project this task belongs to"
          }
        },
        "required": [
          "title",
          "projectId"
        ]
      },
      "UpdateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Complete NestJS assignment",
            "description": "Title of the task"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "completed"
            ],
            "example": "todo",
            "description": "Current status of the task"
          },
          "description": {
            "type": "string",
            "example": "Implement authentication and Swagger documentation",
            "description": "Detailed description of the task"
          }
        }
      },
      "DeleteResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "deleted": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "deleted"
        ]
      },
      "ProjectResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Task Management System"
          },
          "tasks": {
