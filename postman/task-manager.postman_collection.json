{
  "info": {
    "_postman_id": "b3f5d0c2-5b1e-4f0a-9d7c-6a2e8f4c1d90",
    "name": "Task Manager API",
    "description": "Week 8 collection for the Task Manager API. Run the requests in order: Register generates a unique email, Login stores the JWT in the `token` collection variable, then the project and task requests reuse the stored ids. Swagger is served at {{baseUrl}}/api and the OpenAPI document is in docs/openapi.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "App",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns Hello World!', () => pm.expect(pm.response.text()).to.eql('Hello World!'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": []
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Unauthenticated health check."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', pm.variables.replaceIn('{{$randomEmail}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201', () => pm.response.to.have.status(201));",
                  "pm.test('returns a message', () => pm.expect(pm.response.json().message).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["users", "register"]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Creates an account. The pre-request script generates a unique email so the request can be re-run."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "const token = pm.response.text().trim();",
                  "pm.collectionVariables.set('token', token);",
                  "pm.test('returns a JWT', () => pm.expect(token.split('.')).to.have.lengthOf(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["users", "login"]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Returns the signed JWT as plain text and stores it in the `token` collection variable."
          },
          "response": []
        },
        {
          "name": "Get profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns the authenticated user', () => pm.expect(body.email).to.eql(pm.collectionVariables.get('userEmail')));",
                  "pm.test('never returns the password', () => pm.expect(body).to.not.have.property('password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            },
            "description": "Returns the profile of the bearer token's user."
          },
          "response": []
        },
        {
          "name": "Change user role (admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('is handled by the API', () => pm.expect([200, 403, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{targetUserId}}/role",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{targetUserId}}", "role"]
            },
            "description": "Promotes a user to admin. Requires a token whose role is `admin`; a normal user receives 403 FORBIDDEN."
          },
          "response": []
        }
      ]
    },
